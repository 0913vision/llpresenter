  "id": "1b3e5d7f-9a1c-4e3d-8f5a-6b7c8d9e0f11",
  "title": "새벽을 여는 노래",
  "background": "6f1c2a8e-3b4d-4e5f-8a6b-7c8d9e0f1a2b",
  "slides": [
    {
      "label": "1절",
      "lines": ["어둠이 물러가는 새벽에", "작은 빛 하나 내게 비추네"]
    },
    {
      "label": "2절",
      "lines": ["지친 걸음 멈춰 선 그 자리", "따뜻한 손길 나를 일으켜"]
    },
    {
      "label": "프리코러스",
      "lines": ["조용히 귀 기울이면", "들려오는 노래"]
    },
    {
      "label": "후렴",
      "lines": ["이 아침 함께 노래해", "감사의 마음 모아서"]
    },
    {
      "label": "브리지",
      "lines": ["멀리서도 가까이서도", "그 빛은 꺼지지 않네"]
    },
    {
      "label": "엔딩",
      "lines": ["새벽을 여는 노래"]
    }
  ],
  "arrangements": [
    {
      "name": "주일용",
      "slides": [1, 3, 4, 2, 3, 4, 5, 4, 4, 6]
    },
    {
      "name": "짧게",
      "slides": [1, 3, 4, 6]
    }
  ]
}
