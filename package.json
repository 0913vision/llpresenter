{
  "name": "llpresenter",
  "productName": "LoveLight Presenter",
  "version": "0.19.0",
  "description": "Multi-screen lyrics presentation for worship services",
  "author": "0913vision <0913vision@gmail.com>",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "prepare": "node scripts/hooks/install.mts",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "gallery": "vite --config scripts/gallery/vite.config.mts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write . --cache --cache-strategy content",
    "format:check": "node scripts/check-bom.mts && prettier --check . --cache --cache-strategy content",
    "verify": "node scripts/verify.mts",
    "soak": "node scripts/soak/run.mts",
    "bible:convert": "vite build --config scripts/bible/vite.config.mts && node .llp/bible-converter/main.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "electron": "44.9.3",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-tsdoc": "0.5.4",
    "jsdom": "30.1.2",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "iconv-lite": "0.7.3",
    "pretendard": "1.3.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "valibot": "1.5.0",
    "zustand": "5.0.16"
  },
  "overrides": {
    "eslint-plugin-tsdoc": {
      "@typescript-eslint/utils": "8.72.0"
    }
  }
}
